{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": [],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "strictPropertyInitialization": false,
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "sourceMap": true
  },
  "include": ["main.ts", "src/**/*.ts", "native-globals.d.ts"]
}
